CXX = x86_64-w64-mingw32-gcc
CC = x86_64-w64-mingw32-g++
VULKAN_SDK = /home/vel_rax64/.wine/drive_c/VulkanSDK/1.3.290.0
LDFLAGS = -I$(VULKAN_SDK)/Include -L$(VULKAN_SDK)/Lib -static-libgcc -static-libstdc++ -static -mconsole -lgdi32 -lwinmm -lvulkan-1
CXXFLAGS = -c -std=c++20 -g -Wall -I$(VULKAN_SDK)/Include -O0 -mconsole
CFLAGS = -c -g -Wall
INC = -I./include
TEX = -I./textures
BUILD = build
SOURCES = ./src/Engine.cpp ./src/EngineMain.cpp \
	  ./src/Event.cpp ./src/WinApi/ChronoWin.cpp ./src/TimerCreator.cpp \
	  ./src/VertexData.cpp ./src/Systems/CollisionSystem.cpp ./src/Systems/AnimationSystem.cpp \
	  ./src/Systems/PhysicsSystem.cpp ./src/ComponentManager.cpp ./src/EntityManager.cpp ./src/Systems/MovementSystem.cpp \
	  ./src/SystemManager.cpp ./src/Systems/ProjectileSystem.cpp \
	  ./src/WinApi/SoundEngineWaveform.cpp ./src/SoundEngineFactory.cpp ./src/GraphicAPI/Vulkan.cpp \
	  ./src/TextureManager.cpp ./src/WavefrontObjParser.cpp ./src/MeshManager.cpp ./src/JsonParser.cpp \
	  ./src/WinApi/WindowWinVulkan.cpp \
	  ./textures/chelik.cpp ./textures/witch.cpp ./textures/crosshair.cpp ./textures/gray.cpp \
	  ./textures/container2.cpp ./textures/container2_specular.cpp \
	  ./src/Systems/DamageSystem.cpp ./src/Systems/EnemySystem.cpp ./textures/fontAtlas.cpp ./textures/inventorySlot.cpp \
	  ./src/Systems/ItemSystem.cpp
OBJECTS = $(SOURCES:./src/%.cpp=$(BUILD)/%.o)
EXECUTABLE = winGame

all: $(SOURCES) $(EXECUTABLE)

$(EXECUTABLE): $(OBJECTS)
	$(CC) $(OBJECTS) -o $(BUILD)/$@ $(LDFLAGS)

$(BUILD)/%.o : ./src/%.cpp
	mkdir -p $(@D)
	$(CC) $(INC) $(TEX) $(CXXFLAGS) $< -o $@

$(BUILD)/%.o : %.c
	$(C) $(INC) $(TEX) $(CFLAGS) $< -o $@

clean:
	rm -rf $(BUILD)/*
