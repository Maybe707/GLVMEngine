CC = x86_64-w64-mingw32-g++
LDFLAGS = -lgdi32 -lopengl32
CXXFLAGS = -c -std=c++17 -g -Wall
CFLAGS = -c -g -Wall
SOURCES = Engine.cpp EngineMain.cpp GLPointer.c WindowCreator.cpp RenderSystem.cpp ShaderProgram.cpp Event.cpp WindowWin.cpp ChronoWin.cpp TimerCreator.cpp VertexData.cpp CollisionSystem.cpp AnimationSystem.cpp

OBJECTS = $(SOURCES:.cpp=.o)
EXECUTABLE = rpgWin

all: $(SOURCES) $(EXECUTABLE)

$(EXECUTABLE): $(OBJECTS)
	$(CC) $(OBJECTS) -o $@ $(LDFLAGS)

%.o : %.cpp
	$(CC) $(CXXFLAGS) $< -o $@

%.o : %.c
	$(C) $(CFLAGS) $< -o $@

clean:
	rm -rf *.o rpgWin

