CC = x86_64-w64-mingw32-g++
LDFLAGS = -lgdi32 -lopengl32

rpgWin: EngineMain.o GLPointer.o WindowCreator.o Texture.o Renderer.o ShaderProgram.o Event.o WindowWin.o stb_image.o ChronoWin.o TimerCreator.o Engine.o VertexData.o Collision.o Player.o StaticObject.o
	        $(CC) -o rpgWin EngineMain.o GLPointer.o WindowCreator.o Texture.o Renderer.o ShaderProgram.o Event.o WindowWin.o stb_image.o ChronoWin.o TimerCreator.o Engine.o VertexData.o Collision.o Player.o StaticObject.o $(LDFLAGS)
EngineMain.o: EngineMain.cpp
	        $(CC) -c -o EngineMain.o EngineMain.cpp
GLPointer.o: GLPointer.c
	        $(CC) -c -o GLPointer.o GLPointer.c
WindowCreator.o: WindowCreator.cpp
	        $(CC) -c -o WindowCreator.o WindowCreator.cpp
Texture.o: Texture.cpp
	        $(CC) -c -o Texture.o Texture.cpp
Renderer.o: Renderer.cpp
	        $(CC) -c -o Renderer.o Renderer.cpp
ShaderProgram.o: ShaderProgram.cpp
	        $(CC) -c -o ShaderProgram.o ShaderProgram.cpp
Event.o: Event.cpp
	        $(CC) -c -o Event.o Event.cpp
WindowWin.o: WindowWin.cpp
	        $(CC) -c -o WindowWin.o WindowWin.cpp
stb_image.o: stb_image.cpp
		$(CC) -c -o stb_image.o stb_image.cpp
ChronoWin.o: ChronoWin.cpp
		$(CC) -c -o ChronoWin.o ChronoWin.cpp
TimerCreator.o: TimerCreator.cpp
		$(CC) -c -o TimerCreator.o TimerCreator.cpp
Engine.o: Engine.cpp
		$(CC) -c -o Engine.o Engine.cpp
VertexData.o: VertexData.cpp
		$(CC) -c -o VertexData.o VertexData.cpp
Collision.o: Collision.cpp
		$(CC) -c -o Collision.o Collision.cpp
Player.o: Player.cpp
		$(CC) -c -o Player.o Player.cpp
StaticObject.o: StaticObject.cpp
		$(CC) -c -o StaticObject.o StaticObject.cpp

clean:
	        rm -rf *.o rpgWin.exe
