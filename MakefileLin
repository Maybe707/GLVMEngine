C = clang
CC = clang++
LDFLAGS = -lGL -lX11
CXXFLAGS = -c -std=c++17 -g -Wall
CFLAGS = -c -g -Wall
INC = -I./include
BUILD = build
SOURCES = $(wildcard *.c) $(wildcard src/*.cpp) $(wildcard src/Components/*.cpp) $(wildcard src/Systems/*.cpp) $(wildcard src/UnixApi/*.cpp)
OBJECTS = $(SOURCES:src/%.cpp=$(BUILD)/%.o)
EXECUTABLE = rpgLin

all: $(EXECUTABLE)

$(EXECUTABLE): $(OBJECTS)
	$(CC) $(LDFLAGS) $(OBJECTS) -o $(BUILD)/$@

$(BUILD)/%.o : %.c
	$(C) $(INC) $(CFLAGS) $< -o $@

$(BUILD)/%.o : ./src/%.cpp
	mkdir -p $(@D)
	$(CC) $(INC) $(CXXFLAGS) $< -o $@

clean:
	rm -r $(BUILD)/*
