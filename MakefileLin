LDFLAGS = -lGL -lX11
CXXFLAGS = -std=c++17 -g -Wall

rpgLin: EngineMain.o GLPointer.o WindowCreator.o Texture.o Renderer.o ShaderProgram.o Event.o WindowX.o stb_image.o ChronoX.o TimerCreator.o
	clang++ -o rpgLin EngineMain.o GLPointer.o WindowCreator.o Texture.o Renderer.o ShaderProgram.o Event.o WindowX.o stb_image.o ChronoX.o TimerCreator.o $(LDFLAGS)
EngineMain.o: EngineMain.cpp
	clang++ $(CXXFLAGS) -c -o EngineMain.o EngineMain.cpp
GLPointer.o: GLPointer.c
	clang -g -Wall -c -o GLPointer.o GLPointer.c
WindowCreator.o: WindowCreator.cpp
	clang++ $(CXXFLAGS) -c -o WindowCreator.o WindowCreator.cpp
Texture.o: Texture.cpp
	clang++ $(CXXFLAGS) -c -o Texture.o Texture.cpp
Renderer.o: Renderer.cpp
	clang++ $(CXXFLAGS) -c -o Renderer.o Renderer.cpp
ShaderProgram.o: ShaderProgram.cpp
	clang++ $(CXXFLAGS) -c -o ShaderProgram.o ShaderProgram.cpp
Event.o: Event.cpp
	clang++ $(CXXFLAGS) -c -o Event.o Event.cpp
WindowX.o: WindowX.cpp
	clang++ $(CXXFLAGS) -c -o WindowX.o WindowX.cpp
stb_image.o: stb_image.cpp
	clang++ $(CXXFLAGS) -c -o stb_image.o stb_image.cpp
ChronoX.o: ChronoX.cpp
	clang++ $(CXXFLAGS) -c -o ChronoX.o ChronoX.cpp
TimerCreator.o: TimerCreator.cpp
	clang++ $(CXXFLAGS) -c -o TimerCreator.o TimerCreator.cpp

clean:
	rm -rf *.o rpgLin
