C = clang
CC = clang++
SANITIZE = -fsanitize=null -fno-omit-frame-pointer -fsanitize=address -fsanitize=undefined
LDFLAGS = -lX11 -lasound -lvulkan -ldl -lpthread -lXxf86vm -lXrandr -lXi -lxcb -lxcb-keysyms -lxcb-xfixes -lxcb-cursor -lX11-xcb -lwayland-client
CXXFLAGS = -c -std=c++23 -static -Wall -Wextra -Wpedantic -Werror -g -march=x86-64-v3 -O2
CFLAGS = -c -g -Wall -Wextra -Wpedantic -Werror -march=x86-64-v3 -O2
INC = -I./include
TEX = -I./textures
BUILD = build
SOURCES = ./src/Engine.cpp ./src/EngineMain.cpp \
	  ./src/Event.cpp ./src/UnixApi/ChronoX.cpp ./src/TimerCreator.cpp \
	  ./src/VertexData.cpp ./src/Systems/CollisionSystem.cpp ./src/Systems/AnimationSystem.cpp \
	  ./src/Systems/PhysicsSystem.cpp ./src/ComponentManager.cpp ./src/EntityManager.cpp ./src/Systems/MovementSystem.cpp \
	  ./src/SystemManager.cpp ./src/Systems/ProjectileSystem.cpp \
	  ./src/UnixApi/SoundEngineAlsa.cpp ./src/SoundEngineFactory.cpp ./src/GraphicAPI/Vulkan.cpp \
	  ./src/TextureManager.cpp ./src/WavefrontObjParser.cpp ./src/MeshManager.cpp ./src/JsonParser.cpp \
	  ./src/UnixApi/WindowXVulkan.cpp ./src/UnixApi/WindowXCBVulkan.cpp \
	  ./textures/chelik.cpp ./textures/witch.cpp ./textures/crosshair.cpp ./textures/gray.cpp \
	  ./textures/container2.cpp ./textures/container2_specular.cpp \
	  ./src/Systems/DamageSystem.cpp ./src/Systems/EnemySystem.cpp ./textures/fontAtlas.cpp ./textures/inventorySlot.cpp \
	  ./src/Systems/ItemSystem.cpp ./src/ProceduralLevelGeneratingSystem.cpp ./src/Network/UDP_ServerLinux.cpp \
	  ./src/Network/UDP_ClientLinux.cpp ./src/UnixApi/WindowWaylandVulkan.cpp \
	  ./src/UnixApi/WaylandVariables.cpp ./textures/tileset.cpp \
	  ./src/Systems/InventorySystem.cpp

SOURCES_C = xdg-shell-protocol.c pointer-constraints-unstable-v1-protocol.c relative-pointer-unstable-v1-protocol.c
OBJECTS = $(SOURCES:./src/%.cpp=$(BUILD)/%.o)
OBJECTS_C = $(SOURCES_C:%.c=$(BUILD)/%.o)
EXECUTABLE = linGame

all: $(EXECUTABLE)

$(EXECUTABLE): $(OBJECTS) $(OBJECTS_C)
	$(CC) $(LDFLAGS) $(SANITIZE) $(OBJECTS) $(OBJECTS_C) -o $(BUILD)/$@

$(BUILD)/%.o : ./src/%.cpp
	mkdir -p $(@D)
	$(CC) $(INC) $(TEX) $(SANITIZE) $(CXXFLAGS) $< -o $@

$(BUILD)/%.o : %.c
	$(C) $(INC) $(TEX) $(SANITIZE) $(CFLAGS) $< -o $@

clean:
	rm -rf $(BUILD)/*
