C = clang
CC = clang++
OPT ?= -O1
SANITIZE = -fsanitize=null -fno-omit-frame-pointer -fsanitize=address -fsanitize=undefined
#SANITIZE =
LDFLAGS = -lX11 -lasound -lvulkan -ldl -lpthread -lXxf86vm -lXrandr -lXi -lxcb -lxcb-keysyms -lxcb-xfixes -lxcb-cursor -lX11-xcb -lwayland-client
CXXFLAGS = -std=c++20 -Wall -Wextra -Wpedantic -Werror -g $(OPT) -MMD -MP
CFLAGS = -g -Wall -Wextra -Wpedantic -Werror -MMD -MP
INC = -I./include
TEX = -I./textures
BUILD = build
include make_files/common_sources.mk
SOURCES = $(COMMON_SOURCES) ./src/UnixApi/ChronoX.cpp \
    ./src/UnixApi/SoundEngineAlsa.cpp \
    ./src/UnixApi/WindowXVulkan.cpp \
    ./src/UnixApi/WindowXCBVulkan.cpp \
    ./src/Network/UDP_ServerLinux.cpp \
    ./src/Network/UDP_ClientLinux.cpp \
    ./src/UnixApi/WindowWaylandVulkan.cpp \
    ./src/UnixApi/WaylandVariables.cpp

SOURCES_C = xdg-shell-protocol.c pointer-constraints-unstable-v1-protocol.c relative-pointer-unstable-v1-protocol.c
OBJECTS = $(patsubst ./%.cpp,$(BUILD)/%.o,$(SOURCES))
OBJECTS_C = $(SOURCES_C:%.c=$(BUILD)/%.o)
EXECUTABLE = linGame
APP_OBJECTS = $(BUILD)/src/EngineMain.o $(BUILD)/src/Demo/DemoScene.o $(filter $(BUILD)/textures/%,$(OBJECTS))
CORE_OBJECTS = $(filter-out $(APP_OBJECTS),$(OBJECTS)) $(OBJECTS_C)
LIBRARY = $(BUILD)/libglvm.a

.PHONY: all clean run test test-runtime shaders
all: shaders $(BUILD)/$(EXECUTABLE)

shaders:
	python3 scripts/compile_shaders.py

$(LIBRARY): $(CORE_OBJECTS)
	$(AR) rcs $@ $(CORE_OBJECTS)

$(BUILD)/$(EXECUTABLE): $(APP_OBJECTS) $(LIBRARY)
	$(CC) $(SANITIZE) $(APP_OBJECTS) $(LIBRARY) $(LDFLAGS) -o $@

$(BUILD)/runtime_tests: tests/runtime_tests.cpp $(LIBRARY)
	$(CC) $(INC) $(SANITIZE) $(CXXFLAGS) $< $(LIBRARY) $(LDFLAGS) -o $@

test-runtime: $(BUILD)/runtime_tests
	./$(BUILD)/runtime_tests

$(BUILD)/%.o : ./%.cpp
	mkdir -p $(@D)
	$(CC) $(INC) $(TEX) $(SANITIZE) $(CXXFLAGS) -c $< -o $@

$(BUILD)/%.o : %.c
	mkdir -p $(@D)
	$(C) $(INC) $(TEX) $(SANITIZE) $(CFLAGS) -c $< -o $@

run: all
	cd $(BUILD) && ./$(EXECUTABLE)

test: test-runtime
	bash tests/run_core_tests.sh
	python3 tests/check_architecture.py

-include $(OBJECTS:.o=.d) $(OBJECTS_C:.o=.d)

clean:
	rm -rf $(BUILD)/*
