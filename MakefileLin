C = clang
CC = clang++
LDFLAGS = -lGL -lX11 -lasound
CXXFLAGS = -c -std=c++17 -g -Wall
CFLAGS = -c -g -Wall
INC = -I./include
BUILD = build
SOURCES = ./src/Engine.cpp ./src/EngineMain.cpp GLPointer.c ./src/WindowCreator.cpp ./src/Systems/RenderSystem.cpp \
	  ./src/ShaderProgram.cpp ./src/Event.cpp ./src/UnixApi/WindowX.cpp ./src/UnixApi/ChronoX.cpp ./src/TimerCreator.cpp \
	  ./src/VertexData.cpp ./src/Systems/CollisionSystem.cpp ./src/Systems/AnimationSystem.cpp ./src/Systems/GUISystem.cpp \
	  ./src/Systems/PhysicsSystem.cpp ./src/ComponentManager.cpp ./src/EntityManager.cpp ./src/Systems/MovementSystem.cpp \
	  ./src/SystemManager.cpp ./src/chelik.cpp ./src/Systems/ProjectileSystem.cpp ./src/Systems/CameraSystem.cpp
OBJECTS = $(SOURCES:./src/%.cpp=$(BUILD)/%.o)
EXECUTABLE = linGame

all: $(SOURCES) $(EXECUTABLE)

$(EXECUTABLE): $(OBJECTS)
	$(CC) $(LDFLAGS) $(OBJECTS) -o $(BUILD)/$@

$(BUILD)/%.o : ./src/%.cpp
	mkdir -p $(@D)
	$(CC) $(INC) $(CXXFLAGS) $< -o $@

$(BUILD)/%.o : %.c
	$(C) $(INC) $(CFLAGS) $< -o $@

clean:
	rm -r $(BUILD)/*
