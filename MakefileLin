C = clang
CC = clang++
LDFLAGS = -lGL -lX11
CXXFLAGS = -c -std=c++17 -g -Wall
CFLAGS = -c -g -Wall
SOURCES = Engine.cpp EngineMain.cpp GLPointer.c WindowCreator.cpp TextureComponent.cpp RenderSystem.cpp ShaderProgram.cpp Event.cpp WindowX.cpp ChronoX.cpp TimerCreator.cpp VertexData.cpp CollisionSystem.cpp MatrixComponent.cpp	
OBJECTS = $(SOURCES:.cpp=.o)
EXECUTABLE = rpgLin

all: $(SOURCES) $(EXECUTABLE)

$(EXECUTABLE): $(OBJECTS)
	$(CC) $(LDFLAGS) $(OBJECTS) -o $@

%.o : %.cpp
	$(CC) $(CXXFLAGS) $< -o $@

%.o : %.cpp
	$(C) $(CFLAGS) $< -o $@

clean:
	rm -rf *.o rpgLin
