CFLAGS = -std=c++17 -O2 -g -Wall
LDFLAGS = -lglfw -lvulkan -ldl -lpthread -lX11 -lXxf86vm -lXrandr -lXi
INC = ./vulkan_win/x64/vulkan-1.dll

VulkanTest: mainX.cpp WindowXvK.cpp
	g++ $(CFLAGS) mainX.cpp WindowXvK.cpp -o bin $(LDFLAGS)

.PHONY: test clean

test: VulkanTest
	./VulkanTest

clean:
	rm -f VulkanTest

